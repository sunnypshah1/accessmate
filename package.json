{
    "name": "accessmate-ai",
    "private": true,
    "packageManager": "pnpm@9.0.0",
    "scripts": {
        "build": "pnpm -r --workspace-concurrency=1 build",
        "dev": "pnpm --filter ./apps/* dev",
        "lint": "pnpm -r lint",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "format": "pnpm -r format"
    },
    "workspaces": [
        "apps/*",
        "services/*",
        "libs/*"
    ]
}